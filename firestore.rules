rules_version = '2';
// Yalnızca kulüp üyeleri okuyup yazabilir. E-postalar config.js ile aynı olmalı, küçük harfle.
service cloud.firestore {
match /databases/{database}/documents {
function isViewer() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email.lower() in ['asparagas90@gmail.com']; } function isMember() {
return request.auth != null
&& request.auth.token.email_verified == true
&& request.auth.token.email.lower() in [
'lycaeninaee@gmail.com',
'elifebrarsariahmet@gmail.com',
'taskiransebnem@gmail.com'
];
}
match /{document=**} {
allow read: if isMember() || isViewer(); allow write: if isMember();
}
}
}
